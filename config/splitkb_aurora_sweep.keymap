#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&mt {
    //  flavor = "tap-preferred";
    // tapping-term-ms = <200>;
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp TAB>;
        };

        combo_tab {
            timeout-ms = <25>;
            key-positions = <10 11>;
            bindings = <&kp BACKSPACE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default {
            bindings = <
&kp Q             &kp W               &kp E  &kp R  &kp T    &kp Y  &kp U  &kp I      &kp O            &kp P
&kp A             &kp S               &kp D  &kp F  &kp G    &kp H  &kp J  &kp K      &kp L            &kp SEMICOLON
&mt LEFT_SHIFT Z  &kp X               &kp C  &kp V  &kp B    &kp N  &kp M  &kp COMMA  &kp DOT          &mt LSHFT FSLH
&lt 1 ESCAPE      &mt LEFT_ALT SPACE                                                  &mt RCTRL ENTER  &mo 2
            >;
        };

        left {
            bindings = <
&kp LA(TAB)  &kp PAGE_DOWN       &kp UP_ARROW     &kp PAGE_UP      &kp N5        &kp COMMA     &kp N7        &kp N8        &kp N9           &kp MINUS
&kp HOME     &kp LEFT_ARROW      &kp DOWN_ARROW   &kp RIGHT_ARROW  &kp END       &kp PERIOD    &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6     &kp EQUAL
&kp LSHIFT   &kp TILDE           &kp NON_US_BSLH  &kp NON_US_HASH  &kp TILDE2    &kp NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3     &kp RIGHT_SHIFT
&mo 1        &mt LEFT_ALT SPACE                                                                                            &mt RCTRL ENTER  &mo 3
            >;
        };

        right {
            bindings = <
&kp EXCL   &kp LEFT_BRACE  &kp RIGHT_BRACE   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS    &kp CARET        &kp AMPERSAND  &kp ASTERISK  &kp MINUS   &kp UNDERSCORE
&kp PIPE   &kp BACKSLASH   &kp FSLH          &kp LEFT_BRACKET      &kp RIGHT_BRACKET        &kp EXCLAMATION  &kp AT_SIGN    &kp HASH      &kp DOLLAR  &kp PERCENT
&kp LSHFT  &kp GRAVE       &kp SINGLE_QUOTE  &kp LESS_THAN         &kp GREATER_THAN         &kp UNDER        &kp LEFT       &kp DOWN      &kp UP      &kp RIGHT
&mo 3      &kp LCTRL                                                                                                                      &kp SPACE   &mo 2
            >;
        };

        tri {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1          &bt BT_SEL 2      &bt BT_SEL 3      &bt BT_SEL 4         &trans  &trans     &trans        &trans      &trans
&bt BT_CLR    &kp NON_US_BACKSLASH  &kp SLASH         &kp LEFT_BRACKET  &kp RIGHT_BRACKET    &trans  &kp PG_UP  &kp K_VOL_UP  &kp K_MUTE  &trans
&bt BT_CLR    &kp GRAVE             &kp SINGLE_QUOTE  &kp LESS_THAN     &kp GREATER_THAN     &trans  &kp PG_DN  &kp K_VOL_DN  &trans      &trans
&trans        &trans                                                                                                          &trans      &trans
            >;
        };
    };
};
